NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# --- Mercado Pago Point (multi-cliente). Solo servidor: NUNCA con NEXT_PUBLIC_ ---
MP_CLIENT_ID=5633945719763385
MP_CLIENT_SECRET=tu-client-secret
MP_REDIRECT_URI=https://tu-dominio/api/mp/callback
MP_WEBHOOK_SECRET=clave-secreta-del-webhook
MP_TOKEN_KEY=una-frase-larga-y-secreta
APP_URL=https://tu-dominio
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Firma de la cookie de sesión del servidor (frase larga y secreta)
SESSION_SECRET=otra-frase-larga-y-secreta

# --- Permisos (rama claude/permisos-2026-11-02; ver docs/PERMISOS_PLAN.md) ---
# 1 = el navegador NO consulta las tablas privadas: todo pasa por /api/datos (sesión firmada). Se lee al compilar (NEXT_PUBLIC_): redeploy tras cambiarla.
NEXT_PUBLIC_DATOS_VIA_SERVIDOR=0
# Negocio "plataforma" (el tuyo): solo su admin puede dar de alta negocios nuevos (/admin/nueva-empresa). Vacío = esa pantalla queda deshabilitada.
PLATAFORMA_EMPRESA_ID=

# --- Seguridad (rama permisos) ---
# PIN_MODO=legacy (por defecto) | mixto | hash   → ver lib/credenciales.ts. No cambiar hasta acordar la migración con el dueño.
PIN_MODO=legacy
# Pepper del hash de PIN (≥32 caracteres, secreto, distinto de SESSION_SECRET). Solo se usa en modos mixto/hash y en scripts/migrar-pins-a-hash.mjs.
PIN_PEPPER=
# DATOS_CATALOGO=estricto (por defecto) | suma  → "estricto": las líneas de una venta deben existir en productos con su precio vigente.
DATOS_CATALOGO=estricto
